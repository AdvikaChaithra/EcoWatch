# ── Node ──────────────────────────────────────────────────────────────────────
/node_modules

# ── Next.js ───────────────────────────────────────────────────────────────────
/.next/
/out/
/build

# ── Env files (never commit real secrets) ─────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env

# ── Python venv & build artifacts ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
venv/
.venv/
env/
.env/
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/

# ── YOLO model weights (large binary files — download at runtime) ─────────────
*.pt
*.onnx
*.engine
*.tflite

# ── EcoWatch runtime outputs (machine-generated, do not commit) ───────────────
# Evidence frames saved by EvidenceWriter
evidence_snapshots/

# Audit log (candidates JSONL)
logs/

# ByteTrack tracker state (auto-created by ultralytics)
bytetrack_buffer/
runs/

# Camera zone overrides with real coordinates (template camera_zones.json is committed)
# Uncomment if you save real zone coords locally:
# backend/camera_zones_local.json

# ── Misc ──────────────────────────────────────────────────────────────────────
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
