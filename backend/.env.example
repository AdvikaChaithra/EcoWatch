# ── EcoWatch backend/.env.example ────────────────────────────────────────────
# Copy this file to backend/.env and fill in your values.
# DO NOT commit backend/.env to version control.

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# ── Next.js public vars (for frontend Supabase client) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
# Newer projects: publishable key (preferred over the anon key when set)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Database (optional direct connection) ────────────────────────────────────
DATABASE_URL=postgresql://postgres.<project>:<password>@<host>:6543/postgres?pgbouncer=true

# ── FastAPI backend ───────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000

# ── CORS (comma-separated, no wildcards in production) ───────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Security keys ─────────────────────────────────────────────────────────────
# Engine API key for all /api/vision/* and /api/littering_event endpoints.
# Set the same value in both .env (FastAPI reads it) and vision_engine reads it.
# Leave blank to disable enforcement during development.
ENGINE_API_KEY=

# API key protecting the SMS relay endpoint.
# Leave blank to disable (dev). Required in production.
SMS_API_KEY=

# ── Twilio SMS (Part 2) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+91xxxxxxxxxx

# ── Single Camera Configuration ───────────────────────────────────────────────
# CAMERA_SOURCE: 0 = first webcam, 1 = second webcam, or full RTSP URL
# Examples:  CAMERA_SOURCE=0
#            CAMERA_SOURCE=rtsp://192.168.1.100:554/stream
CAMERA_SOURCE=0
CAMERA_ID=CAM_01
CAMERA_NAME=EcoWatch Test Camera
CAMERA_LATITUDE=12.9783
CAMERA_LONGITUDE=77.6408
CAMERA_LOCATION_NAME=Test Location, Indiranagar
CAMERA_WARD=Ward 75

# ── YOLO model paths (A6) ─────────────────────────────────────────────────────
# Use the same model for both person and waste (COCO stop-gap).
PERSON_MODEL_PATH=yolov8n.pt
WASTE_MODEL_PATH=yolov8n.pt

# Waste COCO class IDs (A6). Default: bottle=39, cup=41.
# For a fine-tuned litter model, set the class IDs it was trained on.
WASTE_CLASS_IDS=39,41

# ── Detection confidence thresholds ──────────────────────────────────────────
PERSON_CONF_THRESHOLD=0.55
TRASH_CONF_THRESHOLD=0.40

# ── Littering state machine — distances (multiples of person bbox height, A3) ─
# 0.5 × person_height means association starts within half-body-length proximity
ASSOCIATION_DIST_PERSON_HEIGHTS=0.5
SEPARATION_DIST_PERSON_HEIGHTS=0.8
DEPARTURE_DIST_PERSON_HEIGHTS=1.0
TOLERANCE_DIST_PERSON_HEIGHTS=0.12
CARRY_MIN_DISP_PERSON_HEIGHTS=0.3

# ── Littering state machine — timing (seconds, A2) ────────────────────────────
ASSOCIATION_MIN_SECONDS=0.5
LITTER_DWELL_SECONDS=2.0
STATE_MACHINE_TIMEOUT_SECONDS=60
VIOLATION_EVENT_COOLDOWN_SECONDS=30

# ── Grace period for track loss (A1) ─────────────────────────────────────────
TRACK_LOST_GRACE_SECONDS=0.7

# ── Carry classification (A4) ────────────────────────────────────────────────
CARRY_COMOTION_THRESHOLD=0.4

# ── Evidence (A8) ────────────────────────────────────────────────────────────
EVIDENCE_PRE_SECONDS=4.0
EVIDENCE_DIR=evidence_snapshots

# ── Audit log (A4) ───────────────────────────────────────────────────────────
AUDIT_LOG_PATH=logs/littering_candidates.jsonl

# ── MJPEG stream (A9) ────────────────────────────────────────────────────────
MJPEG_HOST=0.0.0.0
MJPEG_PORT=8001

# ── Display (set false for headless server) ───────────────────────────────────
SHOW_WINDOW=true

# ── Hardening ────────────────────────────────────────────────────────────────
# API key required (X-API-Key header) on mutating REST endpoints. Set in production.
BACKEND_API_KEY=
# Reject admin logins that have no TOTP secret enrolled.
REQUIRE_2FA=false
# Public URL of the MJPEG stream if not served from localhost (returned by /api/camera/config).
MJPEG_PUBLIC_URL=

# Next.js server routes: service-role key (server only, never NEXT_PUBLIC_) lets you re-enable RLS for the anon key.
SUPABASE_SERVICE_ROLE_KEY=
# Enables demo 2FA PIN 123456 for admins without a TOTP secret. NEVER in production.
ALLOW_DEMO_AUTH=false
